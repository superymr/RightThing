# ============================================================
# RightThing 正事 —— 环境变量样例
# 复制为 .env 后填写。所有变量都有默认值，不填也能用 mock 跑通。
# ============================================================

# ---------- 大模型 Provider ----------
# mock   = 本地规则抽取，零依赖、零成本、完全确定性，用于跑通链路与回归测试
# openai = 任意 OpenAI 兼容端点（DeepSeek / Kimi / 通义 / OpenAI / vLLM / Ollama）
LLM_PROVIDER=mock

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 填好后建议先自检（检查连通性 / 模型名 / 抽取质量与幻觉率）：
#   cd backend && python -m app.cli doctor

# 抽取质量要求高时可切换的强模型（留空则复用 LLM_MODEL）
LLM_MODEL_STRONG=

# 抽取任务必须 temperature=0，否则同一份 JD 两次结果不同，无法复现
LLM_TEMPERATURE=0

# 并发上限：控制对 LLM 与目标站点的压力
LLM_MAX_CONCURRENCY=5
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_COMPACT_EXTRACTION=1
LLM_DEEPSEEK_THINKING=0
# 官方DeepSeek默认关闭思考以降低抽取费用；设为1重新开启，其他兼容服务不发送此参数。
# 设为0使用完整抽取（含岗位摘要与职责改写），默认紧凑模式减少输出token。

# ---------- 存储 ----------
# 留空则默认 backend/data/radar.db
JOBRADAR_DB_PATH=

# LLM 结果缓存：强烈建议开启，保证可复现且省钱
JOBRADAR_CACHE=1

# Prompt 版本号：修改 Prompt 后请提升此版本号，否则旧缓存会被复用
JOBRADAR_PROMPT_VERSION=v2

# ---------- 采集 ----------
# 真实站点采集默认关闭；启用后读取允许公开访问的国内岗位来源
JOBRADAR_TARGET_MARKET=cn_mainland
JOBRADAR_ENABLE_LIVE_SOURCES=0
# 内置样例只用于开发/测试；生产分析建议关闭
JOBRADAR_ENABLE_SAMPLE_SOURCE=0
JOBRADAR_LIVE_SOURCE_TIMEOUT=20
JOBRADAR_LIVE_SOURCE_INTERVAL=0.35
JOBRADAR_LIVE_SOURCE_BUDGET=90
# 每次关键词检索最多新抓取多少个 sitemap 详情页；结果会落本地缓存
JOBRADAR_NOWCODER_SCAN_LIMIT=120
# 国家大学生就业服务平台公开职位列表与详情页
JOBRADAR_ENABLE_NCSS_SOURCE=1
# 实习僧公开搜索页与岗位详情页
JOBRADAR_ENABLE_SHIXISENG_SOURCE=1
# 无需密钥的 Jobicy 公共远程岗位 API（默认启用并缓存一小时）
JOBRADAR_ENABLE_JOBICY_SOURCE=1
# Arbeitnow 公共招聘 API；默认缓存前三页（约 975 条，以实际接口为准）
JOBRADAR_ENABLE_ARBEITNOW_SOURCE=1
JOBRADAR_ARBEITNOW_PAGES=3
# 企业官方 Greenhouse 招聘板 token，可按目标公司增删（公开 GET API，无需密钥）
JOBRADAR_GREENHOUSE_BOARDS=figma,discord,airbnb,roblox,pinterest
# JOBRADAR_LIVE_CACHE_DIR=backend/data/live_cache
# 可选：官方 Brave Web Search API，用于补足 sitemap 的长尾召回（密钥只放服务端）
BRAVE_SEARCH_API_KEY=
